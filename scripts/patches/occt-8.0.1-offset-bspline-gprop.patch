+// Offset surfaces preserve their basis UV parameterization. Their basis knots
+// are integration breakpoints even though the evaluated surface remains the
+// original offset (including its existing trims, location and orientation).
+static occ::handle<Geom_BSplineSurface> OffsetBSplineBasis(
+  occ::handle<Geom_Surface> theSurface)
+{
+  bool isOffset = false;
+  for (int depth = 0; depth < 64 && !theSurface.IsNull(); ++depth)
+  {
+    if (theSurface->IsKind(STANDARD_TYPE(Geom_OffsetSurface)))
+    {
+      isOffset = true;
+      theSurface = occ::down_cast<Geom_OffsetSurface>(theSurface)->BasisSurface();
+    }
+    else if (theSurface->IsKind(STANDARD_TYPE(Geom_RectangularTrimmedSurface)))
+    {
+      theSurface = occ::down_cast<Geom_RectangularTrimmedSurface>(theSurface)->BasisSurface();
+    }
+    else
+    {
+      return isOffset ? occ::down_cast<Geom_BSplineSurface>(theSurface)
+                      : occ::handle<Geom_BSplineSurface>();
+    }
+  }
+  return {};
+}
