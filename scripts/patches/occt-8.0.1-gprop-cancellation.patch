 namespace
 {
+// Per-thread state avoids one independent operation cancelling another.
+thread_local BRepGProp_Gauss::CancellationProbeState THE_CANCELLATION_PROBE = {nullptr, nullptr};
+
+static inline void checkCancellation()
+{
+  const auto aProbe = THE_CANCELLATION_PROBE;
+  if (aProbe.Probe != nullptr)
+  {
+    aProbe.Probe(aProbe.Data);
+  }
+}
+
 // Minimal value of interval's range for computation | minimal value of "dim" | ...
