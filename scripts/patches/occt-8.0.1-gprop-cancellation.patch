 void BRepGProp_Gauss::Inertia::Reset()
 {
   memset(reinterpret_cast<void*>(this), 0, sizeof(BRepGProp_Gauss::Inertia));
+}
+
+//=================================================================================================
+
+BRepGProp_Gauss::CancellationProbeState BRepGProp_Gauss::SetCancellationProbe(
+  CancellationProbe theProbe, void* theData) noexcept
+{
+  const auto aPrevious = THE_CANCELLATION_PROBE;
+  THE_CANCELLATION_PROBE = {theProbe, theData};
+  return aPrevious;
 }
 
