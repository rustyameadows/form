  "findings_by_case": {
    "01-paper-tape-unlined": "Complete shallow removable lid and taller base; continuous covering/turn-in rims; intentionally unlined board interiors with real seam tape. Upright registered cover graphics/foil.",
    "02-paper-independent-lining": "Same coherent base/lid family with independent pale floor and lid-top linings; wall-band seam visible as authored; lining remains below the turned rim.",
    "03-fabric-contrasting-lining": "Dark cloth exterior, covered rims and contrasting pale linings; readable cover foil/art; no broad diagonal-wave artifact in the final whole view. Detailed weave verified separately.",
    "04a-board-staples-uncovered": "Intentionally bare board geometry, with exposed crowns visible along closed lid edges and no printed cover art. Removed pieces retain complete trays and buried leg termination is not faked as exposed interior wire.",
    "04b-board-staples-covered": "Covering/lining hides crowns without losing the underlying physical fastened construction; continuous rims and correctly registered cover artwork.",
    "05-mixed-partial-overlap": "Contrasting cloth lid/paper base, deliberately shallow overlap, source-authored wall-band/face-patch seams and small physical overlap-stop ledges. Both halves remain coherent with lid removed.",
    "06-independent-deep-lid": "Larger format with visibly deeper independently stocked paper lid and cloth base; closed seam/proportions remain coherent and both interiors retain complete lining sources."
  },
  "acceptance": "No new whole-model visual blocker observed across these14 closed/removed renders; structural coverage and material/art distinctions agree with the authored configurations and retained references.",
  "limits": [
    "Visual review does not establish manufactured bond strength, staple tool suitability, stock samples or sliding feel.",
    "Final construction packet label-key proofs and technical Canvas overlays are checked separately."
  ]
